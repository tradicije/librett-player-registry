{
  "name": "librett/player-registry",
  "description": "LibreTT Player Registry development catalogue",
  "type": "wordpress-plugin",
  "license": "AGPL-3.0-or-later",
  "require": {
    "php": ">=8.3.3 <8.6",
    "ext-fileinfo": "*",
    "ext-gd": "*",
    "ext-intl": "*",
    "ext-mbstring": "*",
    "ext-mysqli": "*",
    "opis/json-schema": "^2",
    "ramsey/uuid": "^4.0",
    "salsify/json-streaming-parser": "^8.3"
  },
  "autoload": {
    "psr-4": {
      "LibreTT\\PlayerRegistry\\": "src/"
    }
  },
  "config": {
    "allow-plugins": false,
    "sort-packages": true,
    "platform": {
      "php": "8.3.3"
    }
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.95",
    "php-stubs/wordpress-stubs": "^7.1",
    "phpstan/phpstan": "^2.3",
    "phpunit/phpunit": "^12.0"
  },
  "autoload-dev": {
    "psr-4": {
      "LibreTT\\PlayerRegistry\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse --memory-limit=512M",
    "style": "php-cs-fixer check"
  }
}
